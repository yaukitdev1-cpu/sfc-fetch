# Server
PORT=3401
NODE_ENV=development

# Paths (relative to project root)
DATA_DIR=./data
CONTENT_DIR=./data/content
ARCHIVE_DIR=./data/archive
DB_PATH=./data/db/sfc-db.json

# Git integration
GIT_REMOTE=origin
GIT_BRANCH=master
GIT_REPO_URL=https://github.com/yaukitdev1-cpu/sfc-fetch.git
GIT_USER_NAME=sfc-fetch
GIT_USER_EMAIL=sfc-fetch@openclaw.ubuntu
# Note: Set GIT_PAT via actual environment variable for security

# Workflow
AUTO_HYDRATE=true
AUTO_DEHYDRATE=true

# SFC Source
SFC_BASE_URL=https://apps.sfc.hk/edistributionWeb
SFC_RATE_LIMIT=2
SFC_RETRY_ATTEMPTS=5

# Auto-discovery
DISCOVERY_ENABLED=true
DISCOVERY_SCHEDULE_CRON=0 2 * * *
DISCOVERY_CATEGORIES=circulars,consultations,news
DISCOVERY_START_YEAR=2020
DISCOVERY_PAGE_SIZE=100
DISCOVERY_REQUEST_INTERVAL_MS=500

# Backup & Queue
BACKUP_RETENTION=10
QUEUE_MAX_RETRIES=5

# Docling (PDF processing)
DOCLING_PATH=/usr/local/bin/docling
DOCLING_TIMEOUT=30000
